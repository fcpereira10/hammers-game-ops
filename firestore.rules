rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function email()  { return request.auth.token.email.lower(); }
    function member() { return request.auth != null &&
                        exists(/databases/$(db)/documents/members/$(email())); }
    function admin()  { return member() &&
                        get(/databases/$(db)/documents/members/$(email())).data.role == 'admin'; }

    match /members/{id} {
      allow read: if member();
      allow write: if admin();
    }
    match /games/{gid} {
      allow read, create, update: if member();
      allow delete: if admin();
      match /events/{eid} {
        allow read, write: if member();
      }
    }
  }
}
